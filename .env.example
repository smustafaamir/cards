# Groq LLM (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# CORE API (https://core.ac.uk/services/api)
CORE_API_KEY=

# NCBI E-utilities (https://www.ncbi.nlm.nih.gov/account/settings/)
NCBI_EMAIL=
NCBI_API_KEY=

# RAG service (optional overrides)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
